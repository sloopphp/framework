# strict-rules / deprecation-rules are registered automatically by
# phpstan/extension-installer, so no includes are written here (adding them
# would double-include and PHPStan would warn and fail).

parameters:
    level: max
    paths:
        - src
        - tests
        - .claude
    excludePaths:
        # A git worktree under .claude is a whole second checkout, vendor
        # included, and a parallel session writes into it while this runs.
        - .claude/worktrees
    scanFiles:
        - src/Sloop/Helpers/path.php
        - src/Sloop/Helpers/env.php
    stubFiles:
        - vendor/jetbrains/phpstorm-stubs/apcu/apcu.php
    strictRules:
        # PHPUnit's Assert declares its methods static, so the standard
        # $this->assertSame() style is reported as a dynamic call on a static
        # method. It yields 1632 reports under tests alone, none of which are
        # defects. includes cannot be scoped per file, so the rule itself is
        # disabled (suppression via ignoreErrors is forbidden in this project).
        # On the src side this rule currently detects nothing.
        dynamicCallOnStaticMethod: false

        # Forbids variable method calls and variable property access.
        # It fires in 3 spots: RouteRequestHandler (invokes the controller by
        # the action name from the route definition) and Collection::readMember
        # (reads a member by key name), all intentional dynamic dispatch for a
        # framework. Avoiding it means reflection or call_user_func, which is
        # worse for both speed and readability.
        noVariableVariables: false
