# strict-rules / deprecation-rules は phpstan/extension-installer が自動登録するため、
# ここに includes を書かない（書くと二重 include になり PHPStan が警告して失敗する）。

parameters:
    level: max
    paths:
        - src
        - tests
    scanFiles:
        - src/Sloop/Helpers/path.php
        - src/Sloop/Helpers/env.php
    stubFiles:
        - vendor/jetbrains/phpstorm-stubs/apcu/apcu.php
    strictRules:
        # PHPUnit の Assert はメソッドが static 宣言されているため、$this->assertSame()
        # という標準的な書き方が「静的メソッドの動的呼び出し」として報告される。
        # tests 配下だけで 1632 件出るが、いずれも欠陥ではない。
        # includes はファイル単位でスコープできないため、ルール自体を無効化する
        # （ignoreErrors による抑制は本プロジェクトで禁止されているため使わない）。
        # src 側でこのルールが検出するものは現時点で 0 件。
        dynamicCallOnStaticMethod: false

        # 可変メソッド呼び出し・可変プロパティアクセスの禁止。
        # 発火箇所は RouteRequestHandler（ルート定義のアクション名でコントローラを呼ぶ）と
        # Collection::readMember（キー名でメンバを読む）の 3 箇所で、いずれも
        # フレームワークとして意図的な動的ディスパッチ。回避すると reflection や
        # call_user_func になり、速度・可読性の両方で劣化する。
        noVariableVariables: false
