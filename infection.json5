{
    "$schema": "./vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 30,
    "logs": {
        "text": "build/infection/infection.log",
        "html": "build/infection/infection.html",
        "summary": "build/infection/summary.log",
        "json": "build/infection/infection.json"
    },
    "tmpDir": "build/infection/tmp",
    // The aggregate floor. Per mutant regressions are caught by
    // .claude/mutation-baseline.php; this only guards against a broad
    // collapse. 99 tolerates 19 escaped mutants against the 4 that exist
    // today, which leaves room for genuinely equivalent ones to appear
    // before the threshold has to be revisited.
    "minMsi": 99,
    "minCoveredMsi": 99,
    "mutators": {
        "@default": true,
        // Equivalent mutants: the mutation changes the AST but the program
        // semantics are preserved, so no test can distinguish them. Ignoring
        // them is the standard workflow (mutation testing cannot kill what
        // is not observable by tests).
        "LogicalAndSingleSubExprNegation": {
            // Container::resolveBinding line 142: the cached-singleton check
            // is a defensive layer. get() already returns early when the id
            // is in $this->instances, so this inner check is unreachable on
            // every call path that exists today. We keep it because it is a
            // correct invariant for resolveBinding's API contract, but the
            // negated branch is equivalent to the original.
            "ignore": [
                "Sloop\\Container\\Container::resolveBinding"
            ]
        },
        "TrueValue": {
            // Container::autowire stores a sentinel in $this->resolving whose
            // value is only checked via isset(). The sentinel is semantically
            // a set-membership flag, not a truth value; true/false are
            // indistinguishable through isset, making TrueValue an equivalent
            // mutant. PHP's idiomatic set-of-strings representation
            // (array<string, true>) is preserved deliberately.
            "ignore": [
                "Sloop\\Container\\Container::autowire"
            ]
        },
        "CastString": {
            // Expression::elt casts an int position with `(string) $position`
            // and then only concatenates it into the SQL. PHP coerces the int
            // during concatenation anyway, so dropping the cast produces the
            // same string. The cast states the intent that the branch and the
            // Expression branch both yield SQL text, so it stays in the source.
            "ignore": [
                "Sloop\\Database\\Query\\Expression::elt::103"
            ]
        },
        "IncrementInteger": {
            // Str::randomHex computes the byte count as `intdiv($length + 1, 2)`
            // so that odd-length requests round up. Changing the `+ 1` to `+ 2`
            // simply asks for one extra byte that substr() then trims off,
            // leaving the visible output unchanged (equivalent mutant).
            // \Random\Randomizer is a final core class whose state machine
            // produces deterministic leading bytes, so a larger getBytes()
            // call yields the same hex prefix. No black-box test can observe
            // the difference, so the mutation cannot be killed.
            "ignore": [
                "Sloop\\Support\\Str::randomHex",
                // Connection::sleepBackoff / logQuerySuccess convert seconds to
                // milliseconds with a literal 1000. Shifting it to 1001 changes
                // a sleep duration or an elapsed-time reading by a tenth of a
                // percent, which is only observable through an upper-bound
                // timing assertion — the exact construct that made the Windows
                // CI run flaky in 2026-08. Deliberately not killed.
                "Sloop\\Database\\Connection::sleepBackoff",
                "Sloop\\Database\\Connection::logQuerySuccess",
                // Connection::transaction's `int $backoffMs = 0` default:
                // raising it to 1 makes the omitted-argument case sleep for one
                // millisecond. Observing that requires timing the call. Pinned
                // to the parameter's line because other integer literals in the
                // same method are killable.
                "Sloop\\Database\\Connection::transaction::495",
                // Expression::placeholders builds the placeholder list with
                // `array_fill(0, $count, '?')` and only ever implodes the
                // result. The start index decides the array keys, which implode
                // discards, so shifting it to 1 leaves the string identical.
                // Pinned to the array_fill line rather than the method so that
                // a future edit adding a killable literal here is not swallowed.
                "Sloop\\Database\\Query\\Expression::placeholders::202"
            ]
        },
        "DecrementInteger": {
            // Str::randomHex: same root cause as IncrementInteger above.
            // Changing the divisor from 2 to 1 just asks for more bytes that
            // are then trimmed by substr(), leaving the output unchanged.
            // Str::random: getInt(0, $charsLen - 1) → getInt(-1, $charsLen - 1)
            // expands the range so -1 may surface; PHP's $chars[-1] resolves
            // to the last character ('9'), so the result keeps the same
            // alphabet and length, only the per-character distribution shifts
            // by ~1.6%. No deterministic black-box assertion can observe the
            // shift without running thousands of samples; equivalent in
            // practice for unit-test purposes.
            "ignore": [
                "Sloop\\Support\\Str::randomHex",
                "Sloop\\Support\\Str::random",
                // Same millisecond-conversion literal as IncrementInteger above,
                // in the opposite direction (1000 → 999).
                "Sloop\\Database\\Connection::sleepBackoff",
                "Sloop\\Database\\Connection::logQuerySuccess",
                // SloopException's `int $statusCode = 0` default. The
                // constructor applies the argument only when it is greater than
                // zero, so 0 and -1 both mean "use the class default" — the
                // documented contract. Pinned to the parameter's line because
                // the `> 0` comparison in the same constructor is killable.
                "Sloop\\Error\\SloopException::__construct::62",
                // Same array_fill start index as IncrementInteger above, in the
                // opposite direction (0 → -1).
                "Sloop\\Database\\Query\\Expression::placeholders::202"
            ]
        },
        "GreaterThan": {
            // Connection::sleepBackoff guards usleep with `$backoffMs > 0`.
            // Relaxing it to `>= 0` only adds a usleep(0) call, which is not
            // observable. Connection::logQuerySuccess compares the measured
            // elapsed time against the slow-query threshold; distinguishing
            // `>` from `>=` needs a query whose duration lands exactly on the
            // threshold, which no deterministic test can arrange.
            "ignore": [
                "Sloop\\Database\\Connection::sleepBackoff",
                "Sloop\\Database\\Connection::logQuerySuccess"
            ]
        },
        "LogicalAnd": {
            // Connection::shouldMeasureElapsed decides whether to call
            // microtime() before a query. Both call sites re-check
            // `$this->logger !== null` before logging, so turning the && into
            // an || changes only whether a timestamp is taken — never what is
            // written to the log.
            "ignore": [
                "Sloop\\Database\\Connection::shouldMeasureElapsed"
            ]
        },
        "AssignCoalesce": {
            // Connection::dialect and RouteRequestHandler::reflectParameters
            // memoize with `??=`. Replacing it with `=` recomputes the value
            // from inputs that are themselves already cached (serverVersion()
            // has its own `??=`; reflection is pure), so neither the returned
            // value nor the number of round trips to a collaborator changes.
            // Same reasoning as the Str::snake / Str::studly entries below.
            "ignore": [
                "Sloop\\Database\\Connection::dialect",
                "Sloop\\Http\\RouteRequestHandler::reflectParameters"
            ]
        },
        "Coalesce": {
            // Str::camel reads its memo with `??`. The mutation makes the
            // method recompute and overwrite the cache with the same value.
            "ignore": [
                "Sloop\\Support\\Str::camel"
            ]
        },
        "NullSafeMethodCall": {
            // RouteRequestHandler::resolveBuiltinParameter is reached only for
            // parameters that resolveParameter has already narrowed to a
            // ReflectionNamedType, so `getType()` cannot be null there. The
            // `?->` is defensive; dropping it takes an unreachable branch.
            "ignore": [
                "Sloop\\Http\\RouteRequestHandler::resolveBuiltinParameter"
            ]
        },
        "RoundingFamily": {
            // TraceContext::elapsedMs rounds a live microtime() delta. round()
            // versus ceil()/floor() differ by at most one millisecond on a
            // value that is not reproducible between runs, so no deterministic
            // assertion can separate them.
            "ignore": [
                "Sloop\\Log\\TraceContext::elapsedMs"
            ]
        },
        "PregMatchRemoveCaret": {
            // Route::compilePattern matches each segment against
            // `/^\{(\w+)}$/`. The segments come from preg_split with
            // PREG_SPLIT_DELIM_CAPTURE on the same `{\w+}` shape, so a segment
            // either is exactly a placeholder or contains no complete
            // placeholder at all. No input can distinguish the anchored
            // pattern from the unanchored one.
            "ignore": [
                "Sloop\\Routing\\Route::compilePattern"
            ]
        },
        "PregMatchRemoveDollar": {
            // Same segment-shape argument as PregMatchRemoveCaret above.
            "ignore": [
                "Sloop\\Routing\\Route::compilePattern"
            ]
        },
        "Concat": {
            // Str::snake builds its cache key as `$value . $delimiter`.
            // Reversing the operands to `$delimiter . $value` still yields
            // a unique cache key for each (value, delimiter) pair, so the
            // observable behaviour (return value, cache hit/miss outcome) is
            // identical. Equivalent mutant.
            "ignore": [
                "Sloop\\Support\\Str::snake"
            ]
        },
        "ReturnRemoval": {
            // Str::snake / Str::studly cache hit branches return the cached
            // value early. Removing the early return causes the body to run
            // again and overwrite the cache with the same computed value, so
            // the visible output is unchanged; only an unobservable performance
            // difference remains. Equivalent in black-box test terms.
            "ignore": [
                "Sloop\\Support\\Str::snake",
                "Sloop\\Support\\Str::studly",
                // ConnectionManager::applyQueryTimeout returns early when the
                // pool declares no timeout. It is only ever called with a
                // freshly built Connection, whose timeout is already null and
                // whose applied flag is already false, so falling through to
                // setQueryTimeoutMs(null) re-assigns the current state.
                "Sloop\\Database\\ConnectionManager::applyQueryTimeout",
                // Route::compilePattern returns early for patterns without a
                // placeholder. Falling through compiles a regex that match()
                // never consults, because it short-circuits on an empty
                // paramNames list and compares the literal pattern instead.
                "Sloop\\Routing\\Route::compilePattern",
                // Collection::from returns early for arrays; the fall-through
                // reaches iterator_to_array(), which accepts arrays and
                // preserves keys, producing the same collection.
                "Sloop\\Support\\Collection::from",
                // Collection::min / max return early for an empty collection.
                // Falling through runs a loop over nothing and returns the
                // still-null accumulator.
                "Sloop\\Support\\Collection::min",
                "Sloop\\Support\\Collection::max",
                // The entries below are pinned to a line because the same
                // method contains other early returns whose removal *is*
                // observable, so a method-wide ignore would discard a working
                // signal.
                //
                // Application::dispatchRoute returns early when a route has no
                // middleware. The fall-through builds a MiddlewareDispatcher
                // with an empty pipeline, which delegates straight to the same
                // final handler and returns the same response.
                "Sloop\\Foundation\\Application::dispatchRoute::150",
                // TracingMiddleware::extractTraceId returns null for an empty
                // header. The fall-through runs the traceparent regex against
                // '', which cannot match, and returns null on the next line.
                "Sloop\\Http\\Middleware\\TracingMiddleware::extractTraceId::109",
                // LogManager::resolveChannelProcessors returns early when the
                // channel declares no processor names. Falling through iterates
                // an empty name list and returns the same empty array.
                "Sloop\\Log\\LogManager::resolveChannelProcessors::242",
                // Arr::last returns end($array) for the callback-less case. The
                // fall-through calls first() on the reversed array with a null
                // callback, which resolves to the same element.
                "Sloop\\Support\\Arr::last::181",
                // Collection::contains returns false after an exhausted
                // callable scan. Falling through runs in_array() with the
                // callable as the needle, which is never present among the
                // items, so the result is false either way.
                "Sloop\\Support\\Collection::contains::204"
            ]
        },
        "ArrayItemRemoval": {
            // Str::studly's `preg_split('/[-_\s]+/', $value) ?: [$value]`
            // fallback is unreachable: the regex is valid so preg_split never
            // returns false, and an empty input '' produces ['']—truthy, so
            // the `?:` branch is never taken. Removing $value from the
            // fallback array therefore changes nothing observable.
            "ignore": [
                "Sloop\\Support\\Str::studly",
                // ConnectionManager::hasConnectionInTransaction scans the cached
                // primary and replica connections. The primary group cannot
                // contribute a hit today: while building a primary the group is
                // still empty (the caller is inside the isset() miss), and while
                // building a replica a primary that held a transaction would
                // already have been returned by connection()'s transaction
                // routing, so the replica path is never entered. Dropping the
                // group from the scan is therefore unobservable. It stays in the
                // code as the invariant the routing guard relies on.
                "Sloop\\Database\\ConnectionManager::hasConnectionInTransaction"
            ]
        }
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testdox --testsuite=Unit"
}
